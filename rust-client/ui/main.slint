import { Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";

component NavTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> dark-theme: true;
    callback activated();

    height: 42px;
    border-radius: 8px;
    background: selected ? (dark-theme ? #173a42 : #d8f2ed) : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.label;
        color: root.selected ? (root.dark-theme ? #5ce0c4 : #087f70) : (root.dark-theme ? #aabac7 : #52616d);
        font-size: 14px;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea { clicked => { root.activated(); } }
}

component InfoCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> caption;
    in property <bool> dark-theme: true;
    in property <string> action-label;
    callback action-requested();

    background: root.dark-theme ? #121f28 : #ffffff;
    border-width: 1px;
    border-color: root.dark-theme ? #263b47 : #d9e2e8;
    border-radius: 10px;
    VerticalLayout {
        padding: 14px;
        spacing: 5px;
        Text { text: root.title; color: root.dark-theme ? #91a8b7 : #687985; font-size: 12px; }
        Text { text: root.value; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 19px; font-weight: 700; }
        Text { text: root.caption; color: root.dark-theme ? #91a8b7 : #687985; font-size: 12px; wrap: word-wrap; }
        if root.action-label != "": Button { text: root.action-label; clicked => { root.action-requested(); } }
    }
}

export component MainWindow inherits Window {
    title: "Reality Client";
    in property <bool> mobile-layout: false;
    in property <string> app-version;
    width: mobile-layout ? 430px : 1080px;
    height: mobile-layout ? 820px : 760px;
    background: dark-theme ? #0a1117 : #f3f6f8;

    in-out property <bool> dark-theme: true;
    in-out property <int> active-tab: 0;
    in-out property <int> theme-index: 0;
    in-out property <string> profile-name;
    in-out property <string> vless-link;
    in-out property <bool> show-vless-link: false;
    in property <bool> clipboard-paste-supported: false;
    in property <bool> file-dialog-supported: false;
    in-out property <string> status-text: "Отключено";
    in-out property <string> detail-text: "Добавьте VLESS-профиль для начала работы.";
    in-out property <string> log-text;
    in-out property <string> profile-count: "Профили: 0";
    in-out property <bool> delete-confirmation-visible: false;
    in-out property <string> connect-button-text: "Подключить";
    in-out property <bool> config-editor-visible: false;
    in-out property <bool> config-reload-supported: false;
    in-out property <string> config-editor-path;
    in-out property <string> config-editor-text;
    in property <string> config-platform-guidance;
    in-out property <bool> use-full-config: false;
    in-out property <bool> config-tun-enabled: false;
    in-out property <bool> fakeip-enabled: false;
    in property <bool> tun-settings-supported: false;
    in-out property <string> route-domain-input;
    in-out property <string> route-ip-input;
    in-out property <string> route-outbound-input: "direct";
    in-out property <string> route-rules-summary: "Правила ещё не добавлены через интерфейс.";
    in-out property <string> android-apps-input;
    in property <bool> android-app-filter-supported: false;
    in property <[string]> android-app-model;
    in-out property <int> selected-android-app-index: -1;
    in-out property <bool> enable-system-proxy: true;
    in property <bool> system-proxy-supported: false;
    in property <bool> group-controls-visible: false;
    in property <[string]> group-model;
    in-out property <int> selected-group-index: -1;
    in property <[string]> member-model;
    in-out property <int> selected-member-index: -1;
    in-out property <string> traffic-text: "Трафик: —";
    in-out property <string> connection-speed-text: "↑ —  ↓ —";
    in-out property <string> uploaded-total-text: "—";
    in-out property <string> downloaded-total-text: "—";
    in-out property <string> active-connection-count-text: "—";
    in-out property <string> public-ip-text: "Не проверялся";
    in-out property <string> direct-ip-text: "Не проверялся";
    in-out property <string> server-ip-text: "Определите IP узла";
    in-out property <string> server-endpoint-text: "Выберите сервер";
    in-out property <bool> recovery-visible: false;
    in-out property <bool> recovery-confirmation-visible: false;
    in-out property <bool> discard-recovery-confirmation-visible: false;
    in property <[string]> profile-model;
    in-out property <int> selected-profile-index: -1;
    callback save-profile();
    callback paste-profile-link();
    callback profile-selected(index: int);
    callback confirm-delete-profile();
    callback connect-requested();
    callback group-selected(index: int);
    callback member-selected(index: int);
    callback config-load-requested();
    callback config-open-requested();
    callback config-save-requested();
    callback config-save-as-requested();
    callback config-check-requested();
    callback config-reload-requested();
    callback recover-proxy-requested();
    callback discard-proxy-recovery-requested();
    callback theme-selected(index: int);
    callback public-ip-check-requested();
    callback direct-ip-check-requested();
    callback server-ip-check-requested();
    callback network-options-save-requested();
    callback config-options-sync-requested();
    callback routing-rule-add-requested();
    callback routing-rules-clear-requested();
    callback android-app-filter-save-requested();
    callback android-app-add-requested(index: int);

    changed use-full-config => {
        if root.use-full-config { root.enable-system-proxy = false; }
    }

    VerticalLayout {
        padding: root.mobile-layout ? 12px : 20px;
        spacing: root.mobile-layout ? 9px : 14px;

        HorizontalLayout {
            height: root.mobile-layout ? 42px : 54px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "REALITY"; color: root.dark-theme ? #55ddc2 : #087f70; font-size: root.mobile-layout ? 20px : 24px; font-weight: 800; }
                if !root.mobile-layout: Text { text: "SECURE CONNECTION CLIENT"; color: root.dark-theme ? #718796 : #7b8992; font-size: 9px; letter-spacing: 1.2px; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 150px;
                height: 34px;
                border-radius: 17px;
                background: root.status-text == "VPN подключён" || root.status-text == "Прокси запущен" || root.status-text == "Полный конфиг запущен" ? (root.dark-theme ? #123a31 : #dff5ed) : (root.dark-theme ? #18232c : #e6ecef);
                Text {
                    text: root.status-text;
                    color: root.status-text == "VPN подключён" || root.status-text == "Прокси запущен" || root.status-text == "Полный конфиг запущен" ? (root.dark-theme ? #65e0be : #137d60) : (root.dark-theme ? #a9bac6 : #66747d);
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: root.mobile-layout ? 2px : 5px;
            NavTab { horizontal-stretch: 1; label: root.mobile-layout ? "Домой" : "Главная"; selected: root.active-tab == 0; dark-theme: root.dark-theme; activated => { root.active-tab = 0; } }
            NavTab { horizontal-stretch: 1; label: root.mobile-layout ? "Серверы" : "Серверы"; selected: root.active-tab == 1; dark-theme: root.dark-theme; activated => { root.active-tab = 1; } }
            NavTab { horizontal-stretch: 1; label: root.mobile-layout ? "Трафик" : "Соединения"; selected: root.active-tab == 2; dark-theme: root.dark-theme; activated => { root.active-tab = 2; } }
            NavTab { horizontal-stretch: 1; label: root.mobile-layout ? "Ещё" : "Настройки"; selected: root.active-tab == 3; dark-theme: root.dark-theme; activated => { root.active-tab = 3; } }
            NavTab { horizontal-stretch: 1; label: root.mobile-layout ? "О нас" : "О приложении"; selected: root.active-tab == 4; dark-theme: root.dark-theme; activated => { root.active-tab = 4; } }
            if !root.mobile-layout: Rectangle { horizontal-stretch: 1; background: transparent; }
            if !root.mobile-layout: Text { text: "Профили: " + root.profile-count; color: root.dark-theme ? #8fa4b2 : #6c7d87; vertical-alignment: center; font-size: 12px; }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.dark-theme ? #0e171e : #ffffff;
            border-width: 1px;
            border-color: root.dark-theme ? #243743 : #dce4e8;
            border-radius: 12px;

            ScrollView {
            if root.active-tab == 0: VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Подключение"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 22px; font-weight: 700; }
                        Text { text: root.status-text; color: root.dark-theme ? #98adba : #6c7d87; font-size: 13px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: root.connect-button-text;
                        width: 170px;
                        height: 44px;
                        clicked => { root.connect-requested(); }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: root.dark-theme ? #253843 : #e3e9ed;
                }
                if root.mobile-layout: VerticalLayout {
                    spacing: 8px;
                    InfoCard { title: "IP СЕРВЕРА"; value: root.server-ip-text; caption: root.profile-name == "" ? root.server-endpoint-text : root.profile-name + " · " + root.server-endpoint-text; action-label: "Определить IP"; dark-theme: root.dark-theme; action-requested => { root.server-ip-check-requested(); } }
                    InfoCard { title: "МОЙ ВНЕШНИЙ IP БЕЗ VPN"; value: root.direct-ip-text; caption: "Проверка через api.ipify.org · только по нажатию"; action-label: "Проверить напрямую"; dark-theme: root.dark-theme; action-requested => { root.direct-ip-check-requested(); } }
                    InfoCard { title: "МОЙ ВНЕШНИЙ IP ЧЕРЕЗ VPN"; value: root.public-ip-text; caption: "Сервис увидит адрес выхода запроса · только по нажатию"; action-label: "Проверить через VPN"; dark-theme: root.dark-theme; action-requested => { root.public-ip-check-requested(); } }
                    InfoCard { title: "СКОРОСТЬ"; value: root.connection-speed-text; caption: "По счётчикам локального ядра"; dark-theme: root.dark-theme; }
                    InfoCard { title: "ТРАФИК"; value: "↑ " + root.uploaded-total-text; caption: "↓ " + root.downloaded-total-text + " · Активных соединений: " + root.active-connection-count-text; dark-theme: root.dark-theme; }
                }
                if !root.mobile-layout: HorizontalLayout {
                    spacing: 12px;
                    InfoCard { horizontal-stretch: 1; title: "IP СЕРВЕРА"; value: root.server-ip-text; caption: root.profile-name == "" ? root.server-endpoint-text : root.profile-name + " · " + root.server-endpoint-text; action-label: "Определить IP"; dark-theme: root.dark-theme; action-requested => { root.server-ip-check-requested(); } }
                    InfoCard { horizontal-stretch: 1; title: "МОЙ ВНЕШНИЙ IP БЕЗ VPN"; value: root.direct-ip-text; caption: "Проверка через api.ipify.org · только по нажатию"; action-label: "Проверить напрямую"; dark-theme: root.dark-theme; action-requested => { root.direct-ip-check-requested(); } }
                    InfoCard { horizontal-stretch: 1; title: "МОЙ ВНЕШНИЙ IP ЧЕРЕЗ VPN"; value: root.public-ip-text; caption: "Сервис увидит адрес выхода запроса · только по нажатию"; action-label: "Проверить через VPN"; dark-theme: root.dark-theme; action-requested => { root.public-ip-check-requested(); } }
                }
                if !root.mobile-layout: HorizontalLayout {
                    spacing: 12px;
                    InfoCard { horizontal-stretch: 1; title: "СКОРОСТЬ"; value: root.connection-speed-text; caption: "По счётчикам локального ядра"; dark-theme: root.dark-theme; }
                    InfoCard { horizontal-stretch: 1; title: "ТРАФИК"; value: "↑ " + root.uploaded-total-text; caption: "↓ " + root.downloaded-total-text + " · Активных соединений: " + root.active-connection-count-text; dark-theme: root.dark-theme; }
                }
                if root.group-controls-visible: Rectangle {
                    background: root.dark-theme ? #121f28 : #f7fafb;
                    border-width: 1px;
                    border-color: root.dark-theme ? #263b47 : #d9e2e8;
                    border-radius: 10px;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Text { text: "Группа"; color: root.dark-theme ? #a8bdca : #53636d; vertical-alignment: center; }
                        ComboBox { horizontal-stretch: 1; model: root.group-model; current-index <=> root.selected-group-index; selected => { root.group-selected(root.selected-group-index); } }
                        Text { text: "Узел"; color: root.dark-theme ? #a8bdca : #53636d; vertical-alignment: center; }
                        ComboBox { horizontal-stretch: 1; model: root.member-model; current-index <=> root.selected-member-index; selected => { root.member-selected(root.selected-member-index); } }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: root.detail-text; color: root.dark-theme ? #d7b45e : #906315; font-size: 13px; wrap: word-wrap; }
            }

            if root.active-tab == 1: VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Серверы"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 22px; font-weight: 700; }
                        Text { text: "Импортируйте ссылку или выберите сохранённый профиль."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 13px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.profile-count; color: root.dark-theme ? #91a8b7 : #687985; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    ComboBox { horizontal-stretch: 1; model: root.profile-model; current-index <=> root.selected-profile-index; selected => { root.profile-selected(root.selected-profile-index); } }
                    Button { text: root.delete-confirmation-visible ? "Отмена" : "Удалить"; clicked => { root.delete-confirmation-visible = !root.delete-confirmation-visible; } }
                }
                if root.delete-confirmation-visible: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Удалить выбранный профиль?"; color: #d49a41; vertical-alignment: center; }
                    Button { text: "Да, удалить"; clicked => { root.confirm-delete-profile(); root.delete-confirmation-visible = false; } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: root.dark-theme ? #121f28 : #f7fafb;
                    border-width: 1px;
                    border-color: root.dark-theme ? #263b47 : #d9e2e8;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text { text: "Параметры профиля"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 16px; font-weight: 700; }
                        Text { text: "Название"; color: root.dark-theme ? #9cb0bd : #64747e; font-size: 12px; }
                        LineEdit { placeholder-text: "Например, Домашний сервер"; text <=> root.profile-name; }
                        Text { text: "Ссылка VLESS"; color: root.dark-theme ? #9cb0bd : #64747e; font-size: 12px; }
                        LineEdit { placeholder-text: "Вставьте ссылку vless://…"; input-type: root.show-vless-link ? text : password; text <=> root.vless-link; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: root.show-vless-link ? "Скрыть ссылку" : "Показать ссылку"; clicked => { root.show-vless-link = !root.show-vless-link; } }
                            Button { text: "Вставить из буфера"; visible: root.clipboard-paste-supported; clicked => { root.paste-profile-link(); } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button { text: "Сохранить сервер"; clicked => { root.save-profile(); } }
                        }
                        Text { text: "Секретная ссылка хранится в защищённом хранилище профилей и не выводится в журнал."; color: root.dark-theme ? #718796 : #7b8992; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Text { text: root.detail-text; color: root.dark-theme ? #d7b45e : #906315; font-size: 13px; wrap: word-wrap; }
            }

            if root.active-tab == 2: VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Соединения"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 22px; font-weight: 700; }
                        Text { text: "Текущая статистика и журнал ядра."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 13px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "Копировать журнал"; clicked => { log-view.select-all(); log-view.copy(); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    InfoCard { horizontal-stretch: 1; title: "АКТИВНЫЕ СОЕДИНЕНИЯ"; value: root.active-connection-count-text; caption: "Счётчик предоставлен API ядра"; dark-theme: root.dark-theme; }
                    InfoCard { horizontal-stretch: 1; title: "ТЕКУЩАЯ СКОРОСТЬ"; value: root.connection-speed-text; caption: "Входящий и исходящий трафик"; dark-theme: root.dark-theme; }
                }
                Text { text: "События клиента"; color: root.dark-theme ? #c8d6de : #45555f; font-size: 14px; font-weight: 700; }
                log-view := TextEdit {
                    vertical-stretch: 1;
                    text <=> root.log-text;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 13px;
                }
                Text { text: "Детальный список потоков пока не предоставляется API ядра; счётчик выше не является перечнем соединений."; color: root.dark-theme ? #d7b45e : #906315; font-size: 12px; wrap: word-wrap; }
            }

            if root.active-tab == 3: VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Настройки"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 22px; font-weight: 700; }
                        Text { text: "Интерфейс, системная интеграция и расширенная конфигурация."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 13px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ComboBox { width: 150px; model: ["Тёмная тема", "Светлая тема"]; current-index <=> root.theme-index; selected => { root.theme-selected(root.theme-index); } }
                }
                if !root.config-editor-visible: Rectangle {
                    background: root.dark-theme ? #121f28 : #f7fafb;
                    border-width: 1px;
                    border-color: root.dark-theme ? #263b47 : #d9e2e8;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "Подключение и маршрутизация"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 16px; font-weight: 700; }
                        Text { text: "Режим полного JSON открывает все возможности закреплённого ядра: TUN, DNS fake-IP и правила маршрутизации. Совместимость зависит от ОС."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 12px; wrap: word-wrap; }
                        CheckBox { text: "Использовать полный конфиг ядра"; checked <=> root.use-full-config; }
                        CheckBox { text: "Включить системный прокси Windows"; checked <=> root.enable-system-proxy; visible: root.system-proxy-supported; enabled: !root.use-full-config; }
                        if root.use-full-config: Rectangle {
                            background: root.dark-theme ? #0e171e : #ffffff;
                            border-width: 1px;
                            border-color: root.dark-theme ? #263b47 : #d9e2e8;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 7px;
                                Text { text: "DNS и маршрутизация"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 14px; font-weight: 700; }
                                Text { text: "Переключатели изменяют JSON-конфиг. Windows пока не поддерживает TUN в этом клиенте."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 11px; wrap: word-wrap; }
                                CheckBox { text: "TUN: направлять системный трафик через VPN"; checked <=> root.config-tun-enabled; enabled: root.tun-settings-supported; }
                                CheckBox { text: "Fake-IP DNS"; checked <=> root.fakeip-enabled; }
                                if root.android-app-filter-supported: Rectangle {
                                    background: root.dark-theme ? #0a1117 : #ffffff;
                                    border-width: 1px;
                                    border-color: root.dark-theme ? #263b47 : #d9e2e8;
                                    border-radius: 7px;
                                    VerticalLayout {
                                        padding: 9px;
                                        spacing: 6px;
                                        Text { text: "Приложения Android"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 13px; font-weight: 700; }
                                        Text { text: "Оставьте поле пустым для всех приложений. Иначе VPN будет работать только для перечисленных package ID через запятую."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 11px; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            ComboBox { horizontal-stretch: 1; model: root.android-app-model; current-index <=> root.selected-android-app-index; }
                                            Button { text: "Добавить"; clicked => { root.android-app-add-requested(root.selected-android-app-index); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit { horizontal-stretch: 1; placeholder-text: "Или package ID: com.example.app"; text <=> root.android-apps-input; }
                                            Button { text: "Сохранить список"; clicked => { root.android-app-filter-save-requested(); } }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Применить переключатели"; clicked => { root.network-options-save-requested(); } }
                                    Button { text: "Считать из JSON"; clicked => { root.config-options-sync-requested(); } }
                                }
                                Text { text: "Можно вставить домен или ссылку сайта (например, https://vk.com/video); правило применяется ко всему домену. IP-диапазоны задаются в CIDR, например 203.0.113.0/24."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 11px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { horizontal-stretch: 1; placeholder-text: "Домен или URL: vk.com/video"; text <=> root.route-domain-input; }
                                    LineEdit { horizontal-stretch: 1; placeholder-text: "IP/CIDR: 203.0.113.0/24"; text <=> root.route-ip-input; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { horizontal-stretch: 1; placeholder-text: "Тег выхода: direct / proxy"; text <=> root.route-outbound-input; }
                                    Button { text: "Добавить правило"; clicked => { root.routing-rule-add-requested(); } }
                                    Button { text: "Очистить мои правила"; clicked => { root.routing-rules-clear-requested(); } }
                                }
                                Text { text: root.route-rules-summary; color: root.dark-theme ? #8fa4b2 : #687985; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: root.config-editor-visible ? "Закрыть JSON-редактор" : "Открыть JSON-редактор"; clicked => { root.config-editor-visible = !root.config-editor-visible; } }
                            Button { text: "Проверить конфигурацию"; visible: root.config-editor-visible; clicked => { root.config-check-requested(); } }
                        }
                        if root.recovery-visible: VerticalLayout {
                            spacing: 8px;
                            Text { text: "Найдена незавершённая сессия системного прокси."; color: #d49a41; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: root.recovery-confirmation-visible ? "Отмена" : "Восстановить…"; clicked => { root.recovery-confirmation-visible = !root.recovery-confirmation-visible; } }
                                Button { text: root.discard-recovery-confirmation-visible ? "Отмена" : "Удалить копию…"; clicked => { root.discard-recovery-confirmation-visible = !root.discard-recovery-confirmation-visible; root.recovery-confirmation-visible = false; } }
                            }
                            if root.recovery-confirmation-visible: HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Вернуть прежние настройки прокси?"; color: #d49a41; vertical-alignment: center; }
                                Button { text: "Восстановить"; clicked => { root.recover-proxy-requested(); root.recovery-confirmation-visible = false; } }
                            }
                            if root.discard-recovery-confirmation-visible: HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Удалить только сохранённую копию?"; color: #d49a41; vertical-alignment: center; }
                                Button { text: "Удалить копию"; clicked => { root.discard-proxy-recovery-requested(); root.discard-recovery-confirmation-visible = false; } }
                            }
                        }
                    }
                }
                if root.config-editor-visible: Rectangle {
                    vertical-stretch: 1;
                    background: root.dark-theme ? #121f28 : #f7fafb;
                    border-width: 1px;
                    border-color: root.dark-theme ? #263b47 : #d9e2e8;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text { text: "JSON ядра · секреты в файле сохраняются открытым текстом. Ограничьте доступ и используйте link_file. " + root.config-platform-guidance; color: root.dark-theme ? #d7b45e : #906315; font-size: 11px; wrap: word-wrap; }
                        LineEdit { placeholder-text: "Путь к JSON-конфигурации"; text <=> root.config-editor-path; }
                        TextEdit { vertical-stretch: 1; text <=> root.config-editor-text; placeholder-text: "Вставьте конфигурацию ядра…"; wrap: no-wrap; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Открыть…"; visible: root.file-dialog-supported; clicked => { root.config-open-requested(); } }
                            Button { text: "Загрузить"; clicked => { root.config-load-requested(); } }
                            Button { text: "Сохранить"; clicked => { root.config-save-requested(); } }
                            Button { text: "Сохранить как…"; visible: root.file-dialog-supported; clicked => { root.config-save-as-requested(); } }
                            Button { text: "Проверить ядром"; clicked => { root.config-check-requested(); } }
                            Button { text: "Применить"; visible: root.config-reload-supported; clicked => { root.config-reload-requested(); } }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: root.detail-text; color: root.dark-theme ? #d7b45e : #906315; font-size: 12px; wrap: word-wrap; }
            }

            if root.active-tab == 4: VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: "О приложении"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 22px; font-weight: 700; }
                Text { text: "Reality Client"; color: root.dark-theme ? #55ddc2 : #087f70; font-size: 28px; font-weight: 800; }
                Text { text: "Версия " + root.app-version + " · Rust / Slint"; color: root.dark-theme ? #91a8b7 : #687985; font-size: 14px; }
                Rectangle {
                    background: root.dark-theme ? #121f28 : #f7fafb;
                    border-width: 1px;
                    border-color: root.dark-theme ? #263b47 : #d9e2e8;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text { text: "Клиент для Reality Core"; color: root.dark-theme ? #edf5f7 : #17232b; font-size: 16px; font-weight: 700; }
                        Text { text: "Проект объединяет графический клиент и закреплённое сетевое ядро. Набор функций зависит от операционной системы и доступных возможностей ядра."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 13px; wrap: word-wrap; }
                        Text { text: "Исходный код: github.com/ERGFT/reality-client"; color: root.dark-theme ? #55ddc2 : #087f70; font-size: 13px; }
                        Text { text: "Поддерживаемые сборки: Windows, Linux и Android. Статус каждой платформы и ограничения указаны в README репозитория."; color: root.dark-theme ? #91a8b7 : #687985; font-size: 12px; wrap: word-wrap; }
                        Text { text: "Лицензия: GPL-3.0-or-later"; color: root.dark-theme ? #91a8b7 : #687985; font-size: 12px; }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
            }
        }
    }
}
