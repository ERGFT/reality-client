import { ComboBox, LineEdit, Palette, ScrollView, TextEdit } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Дизайн-токены. Все цвета интерфейса берутся отсюда, а не пишутся по месту.
// ---------------------------------------------------------------------------
export global Theme {
    in-out property <bool> dark: true;
    // Material 3 Expressive на телефоне (включается из MainWindow при mobile-layout).
    in-out property <bool> m3: false;
    // Системные динамические цвета Android 12+ (задаёт Rust, если палитра доступна).
    in-out property <bool> dynamic: false;
    in-out property <color> dyn-bg: #0e1513;
    in-out property <color> dyn-surface: #1a211f;
    in-out property <color> dyn-surface-2: #242b29;
    in-out property <color> dyn-surface-3: #2f3634;
    in-out property <color> dyn-outline: #3f4946;
    in-out property <color> dyn-text: #dde4e1;
    in-out property <color> dyn-dim: #bec9c4;
    in-out property <color> dyn-accent: #6ed9c2;
    in-out property <color> dyn-accent-soft: #005046;
    in-out property <color> dyn-on-accent: #00382f;
    in-out property <color> dyn-on-accent-soft: #8cf5de;

    out property <color> bg: dynamic ? dyn-bg : m3 ? (dark ? #0e1513 : #f4fbf8) : (dark ? #0d1014 : #f2f5f8);
    out property <color> surface: dynamic ? dyn-surface : m3 ? (dark ? #1a211f : #e9f0ed) : (dark ? #151a21 : #ffffff);
    out property <color> surface-2: dynamic ? dyn-surface-2 : m3 ? (dark ? #242b29 : #e3eae7) : (dark ? #1c222b : #edf1f5);
    out property <color> surface-3: dynamic ? dyn-surface-3 : m3 ? (dark ? #2f3634 : #dde4e1) : (dark ? #252c37 : #e1e7ee);
    out property <color> outline: dynamic ? dyn-outline : m3 ? (dark ? #3f4946 : #bfc9c5) : (dark ? #2a323d : #d9e0e8);
    out property <color> text: dynamic ? dyn-text : m3 ? (dark ? #dde4e1 : #171d1b) : (dark ? #e9edf2 : #11161c);
    out property <color> dim: dynamic ? dyn-dim : m3 ? (dark ? #bec9c4 : #3f4946) : (dark ? #96a1b1 : #586373);
    out property <color> faint: dynamic ? dyn-dim.with-alpha(0.7) : m3 ? (dark ? #899390 : #6f7976) : (dark ? #667182 : #8793a3);
    out property <color> accent: dynamic ? dyn-accent : m3 ? (dark ? #6ed9c2 : #006b5e) : (dark ? #34d3a8 : #0b9a78);
    out property <color> accent-hover: dynamic ? dyn-accent.brighter(0.15) : m3 ? (dark ? #8ae6d1 : #00574c) : (dark ? #5ae0bb : #087e62);
    out property <color> accent-soft: dynamic ? dyn-accent-soft : m3 ? (dark ? #005046 : #8cf5de) : (dark ? #12342d : #d3f1e8);
    out property <color> on-accent: dynamic ? dyn-on-accent : m3 ? (dark ? #00382f : #ffffff) : (dark ? #04261e : #ffffff);
    out property <color> on-accent-container: dynamic ? dyn-on-accent-soft : m3 ? (dark ? #8cf5de : #00201b) : accent;
    out property <color> warn: dark ? #f2bb55 : #9a6100;
    out property <color> warn-soft: dark ? #33290f : #fbefd2;
    out property <color> danger: dark ? #f27481 : #c4303d;
    out property <color> danger-soft: dark ? #3a1b20 : #fbe1e4;

    // Формы: у Material 3 Expressive крупные скругления и «таблетки».
    out property <length> r-card: m3 ? 28px : 18px;
    out property <length> r-tile: m3 ? 24px : 14px;
    out property <length> r-row: m3 ? 20px : 14px;
    out property <length> r-field: m3 ? 20px : 12px;
}

// ---------------------------------------------------------------------------
// Базовые элементы
// ---------------------------------------------------------------------------
component Icon inherits Path {
    in property <string> glyph;
    in property <color> tint: Theme.dim;
    in property <length> size: 22px;

    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.glyph;
    stroke: root.tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

component Card inherits Rectangle {
    in property <length> pad: 16px;
    in property <color> fill: Theme.surface;

    background: root.fill;
    border-radius: Theme.r-card;
    border-width: Theme.m3 ? 0px : 1px;
    border-color: Theme.outline;

    VerticalLayout {
        padding: root.pad;
        spacing: 10px;
        @children
    }
}

// kind: 0 — основная, 1 — тональная, 2 — контурная, 3 — опасная
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.m3 ? 48px : 42px;
    border-radius: Theme.m3 ? self.height / 2 : 13px;
    background: !root.enabled ? Theme.surface-2
        : root.kind == 0 ? (area.has-hover ? Theme.accent-hover : Theme.accent)
        : root.kind == 1 ? (area.has-hover ? Theme.surface-3 : Theme.surface-2)
        : root.kind == 3 ? (area.has-hover ? Theme.danger-soft : transparent)
        : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: root.kind >= 2 ? 1px : 0px;
    border-color: root.kind == 3 ? Theme.danger : Theme.outline;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.faint
                : root.kind == 0 ? Theme.on-accent
                : root.kind == 3 ? Theme.danger
                : Theme.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    width: Theme.m3 ? 52px : 46px;
    height: Theme.m3 ? 32px : 28px;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.surface-2 : root.checked ? Theme.accent : (Theme.m3 ? Theme.surface-3 : Theme.surface-3);
    border-width: Theme.m3 && !root.checked ? 2px : 0px;
    border-color: Theme.faint;
    animate background { duration: 120ms; }

    Rectangle {
        property <length> size: Theme.m3 ? (root.checked ? 24px : 16px) : 22px;
        width: self.size;
        height: self.size;
        x: Theme.m3 ? (root.checked ? 24px : 6px) : (root.checked ? 20px : 3px);
        y: (parent.height - self.height) / 2 - (Theme.m3 && !root.checked ? 2px : 0px);
        border-radius: self.size / 2;
        background: root.checked ? Theme.on-accent : (root.enabled ? (Theme.m3 ? Theme.faint : Theme.text) : Theme.faint);
        animate x { duration: 150ms; easing: ease-out; }
        animate width { duration: 150ms; }
        animate height { duration: 150ms; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> enabled: true;
    in-out property <bool> checked;

    height: max(52px, content.preferred-height);
    accessible-role: checkbox;
    accessible-label: root.title;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; } }

    content := HorizontalLayout {
        spacing: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.enabled ? Theme.text : Theme.faint;
                font-size: 14px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle { checked <=> root.checked; enabled: root.enabled; }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.accent;
    in property <color> soft: Theme.accent-soft;

    height: 24px;
    border-radius: 12px;
    background: root.soft;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { text: root.text; color: root.tone; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
}

component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 3px;
    Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
    if root.subtitle != "": Text { text: root.subtitle; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
}

component Notice inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;

    background: root.danger ? Theme.danger-soft : Theme.warn-soft;
    border-radius: Theme.r-field;
    HorizontalLayout {
        padding: 12px;
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.warn;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint;

    preferred-width: 0px;
    background: Theme.surface-2;
    border-radius: Theme.r-tile;
    VerticalLayout {
        padding: 14px;
        spacing: 3px;
        Text { text: root.label; color: Theme.dim; font-size: 11px; font-weight: 600; }
        Text { text: root.value; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
        if root.hint != "": Text { text: root.hint; color: Theme.faint; font-size: 11px; overflow: elide; }
    }
}

component FieldLabel inherits Text {
    color: Theme.dim;
    font-size: 12px;
    font-weight: 600;
}

// ---------------------------------------------------------------------------
// Главная кнопка питания: состояние 0 — выключено, 1 — идёт операция, 2 — включено
// ---------------------------------------------------------------------------
component PowerButton inherits Rectangle {
    in property <int> state: 0;
    callback clicked();

    width: 176px;
    height: 176px;
    accessible-role: button;
    accessible-label: root.state == 2 ? "Отключить" : "Подключить";
    accessible-action-default => { root.clicked(); }

    // Внешнее кольцо: у Material 3 его нет, форма самой кнопки меняется.
    if !Theme.m3: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.width / 2;
        background: root.state == 2 ? Theme.accent-soft : transparent;
        border-width: 2px;
        border-color: root.state == 2 ? Theme.accent : (root.state == 1 ? Theme.warn : Theme.outline);
        animate background { duration: 200ms; }
        animate border-color { duration: 200ms; }
    }

    Rectangle {
        x: Theme.m3 ? 0px : 18px;
        y: Theme.m3 ? 0px : 18px;
        width: Theme.m3 ? parent.width : parent.width - 36px;
        height: Theme.m3 ? parent.height : parent.height - 36px;
        // Material 3 Expressive: «скруглённый квадрат» в покое, круг при подключении.
        border-radius: Theme.m3 ? (root.state == 2 ? self.width / 2 : self.width * 0.32) : self.width / 2;
        background: root.state == 2 ? Theme.accent : (Theme.m3 ? (area.has-hover ? Theme.surface-3 : Theme.accent-soft) : (area.has-hover ? Theme.surface-3 : Theme.surface-2));
        animate background { duration: 200ms; }
        animate border-radius { duration: 280ms; easing: ease-in-out; }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Theme.m3 ? 72px : 60px;
            glyph: "M12 2.5 V12 M6.4 5.7 A9 9 0 1 0 17.6 5.7";
            tint: root.state == 2 ? Theme.on-accent : (root.state == 1 ? Theme.warn : (Theme.m3 ? Theme.on-accent-container : Theme.accent));
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Навигация
// ---------------------------------------------------------------------------
component RailItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    callback activated();

    height: 46px;
    border-radius: 14px;
    background: root.selected ? Theme.accent-soft : (area.has-hover ? Theme.surface-2 : transparent);
    animate background { duration: 120ms; }
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; tint: root.selected ? Theme.accent : Theme.dim; } }
        Text {
            text: root.label;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: 14px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component TabItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    callback activated();

    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Rectangle {
            height: 32px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.selected ? 64px : 40px;
                    border-radius: 16px;
                    background: root.selected ? Theme.accent-soft : transparent;
                    animate width { duration: 180ms; easing: ease-out; }
                    animate background { duration: 180ms; }
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 24px; tint: root.selected ? Theme.on-accent-container : Theme.dim; } }
                    }
                }
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.dim;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            horizontal-alignment: center;
        }
    }
    TouchArea { clicked => { root.activated(); } }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback selected(index: int);

    height: Theme.m3 ? 48px : 42px;
    border-radius: Theme.m3 ? self.height / 2 : 13px;
    background: Theme.surface-2;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[index] in root.options: Rectangle {
            border-radius: Theme.m3 ? 22px : 10px;
            background: index == root.current ? (Theme.m3 ? Theme.accent-soft : Theme.surface) : transparent;
            border-width: index == root.current && !Theme.m3 ? 1px : 0px;
            border-color: Theme.outline;
            Text {
                text: option;
                color: index == root.current ? (Theme.m3 ? Theme.accent : Theme.text) : Theme.dim;
                font-size: 13px;
                font-weight: index == root.current ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = index; root.selected(index); }
            }
        }
    }
}

component ProfileRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected: false;
    callback picked();

    height: 56px;
    border-radius: Theme.r-row;
    background: root.selected ? Theme.accent-soft : (area.has-hover ? Theme.surface-3 : Theme.surface-2);
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent;
    animate background { duration: 120ms; }
    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checked: root.selected;
    accessible-action-default => { root.picked(); }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: root.selected ? Theme.accent : Theme.faint;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.selected ? Theme.accent : transparent;
                }
            }
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-size: 14px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.selected: VerticalLayout { alignment: center; Chip { text: "ВЫБРАН"; } }
    }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    Text { text: root.title; color: Theme.text; font-size: 26px; font-weight: 800; }
    if root.subtitle != "": Text { text: root.subtitle; color: Theme.dim; font-size: 13px; wrap: word-wrap; }
}

component IpRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> hint;
    in property <string> action;
    callback requested();

    background: Theme.surface-2;
    border-radius: Theme.r-tile;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; color: Theme.dim; font-size: 11px; font-weight: 700; }
            Text { text: root.value; color: Theme.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.hint; color: Theme.faint; font-size: 11px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            Btn { text: root.action; kind: 2; height: 36px; clicked => { root.requested(); } }
        }
    }
}

export component MainWindow inherits Window {
    title: "Reality Client";
    icon: @image-url("../assets/icon.png");
    in property <bool> mobile-layout: false;
    in property <string> app-version;
    preferred-width: mobile-layout ? 380px : 1080px;
    preferred-height: 760px;
    min-width: mobile-layout ? 320px : 760px;
    min-height: mobile-layout ? 480px : 560px;
    background: Theme.bg;
    default-font-size: 14px;

    in-out property <bool> dark-theme: true;
    in-out property <int> active-tab: 0;
    in-out property <int> theme-index: 0;
    in-out property <string> profile-name;
    in-out property <string> vless-link;
    in-out property <bool> show-vless-link: false;
    in property <bool> clipboard-paste-supported: false;
    in property <bool> file-dialog-supported: false;
    in-out property <string> status-text: "Отключено";
    in-out property <string> detail-text: "Добавьте VLESS-профиль для начала работы.";
    in-out property <string> log-text;
    in-out property <string> profile-count: "Профили: 0";
    in-out property <bool> delete-confirmation-visible: false;
    in-out property <string> connect-button-text: "Подключить";
    in-out property <bool> config-editor-visible: false;
    in-out property <bool> config-reload-supported: false;
    in-out property <string> config-editor-path;
    in-out property <string> config-editor-text;
    in property <string> config-platform-guidance;
    in-out property <bool> use-full-config: false;
    in-out property <bool> config-tun-enabled: false;
    in-out property <bool> fakeip-enabled: false;
    in property <bool> tun-settings-supported: false;
    in-out property <string> route-domain-input;
    in-out property <string> route-ip-input;
    in-out property <string> route-outbound-input: "direct";
    in property <[string]> outbound-model;
    in-out property <int> selected-outbound-index: 0;
    in-out property <string> route-rules-summary: "Правила ещё не добавлены через интерфейс.";
    in-out property <string> android-apps-input;
    in property <bool> android-app-filter-supported: false;
    in property <[string]> android-app-model;
    in-out property <int> selected-android-app-index: -1;
    in-out property <bool> enable-system-proxy: true;
    in property <bool> system-proxy-supported: false;
    in property <bool> group-controls-visible: false;
    in property <[string]> group-model;
    in-out property <int> selected-group-index: -1;
    in property <[string]> member-model;
    in-out property <int> selected-member-index: -1;
    in-out property <string> traffic-text: "Трафик: —";
    in-out property <string> connection-speed-text: "↑ —  ↓ —";
    in-out property <string> uploaded-total-text: "—";
    in-out property <string> downloaded-total-text: "—";
    in-out property <string> active-connection-count-text: "—";
    in property <[string]> connection-model;
    in-out property <string> public-ip-text: "Не проверялся";
    in-out property <string> direct-ip-text: "Не проверялся";
    in-out property <string> server-ip-text: "Определите IP узла";
    in-out property <string> server-endpoint-text: "Выберите сервер";
    in-out property <bool> recovery-visible: false;
    in-out property <bool> recovery-confirmation-visible: false;
    in-out property <bool> discard-recovery-confirmation-visible: false;
    in-out property <bool> tun-cleanup-confirmation-visible: false;
    in property <bool> tun-cleanup-supported: false;
    in property <[string]> profile-model;
    in-out property <int> selected-profile-index: -1;
    callback save-profile();
    callback paste-profile-link();
    callback profile-selected(index: int);
    callback confirm-delete-profile();
    callback connect-requested();
    callback group-selected(index: int);
    callback member-selected(index: int);
    callback config-load-requested();
    callback config-open-requested();
    callback config-save-requested();
    callback config-save-as-requested();
    callback config-check-requested();
    callback config-reload-requested();
    callback recover-proxy-requested();
    callback discard-proxy-recovery-requested();
    callback tun-cleanup-requested();
    callback theme-selected(index: int);
    callback public-ip-check-requested();
    callback direct-ip-check-requested();
    callback server-ip-check-requested();
    callback network-options-save-requested();
    callback config-options-sync-requested();
    callback routing-rule-add-requested();
    callback routing-rules-clear-requested();
    callback outbound-selected(index: int);
    callback android-app-filter-save-requested();
    callback android-app-add-requested(index: int);
    callback open-repository-requested();

    property <bool> compact: root.mobile-layout;
    property <bool> connected: root.connect-button-text == "Отключить";
    property <bool> idle: root.connect-button-text == "Подключить";
    property <int> power-state: root.connected ? 2 : (root.idle ? 0 : 1);
    property <bool> show-diagnostics: false;
    property <length> page-pad: root.compact ? 16px : 32px;
    // AndroidActivity applies real system-bar and display-cutout insets. Keep
    // only a small visual gap here so the page does not start below the clock twice.
    property <length> top-pad: root.mobile-layout ? 14px : 28px;

    changed use-full-config => {
        if root.use-full-config { root.enable-system-proxy = false; }
    }

    init => {
        Theme.m3 = root.mobile-layout;
        Theme.dark = root.dark-theme;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed mobile-layout => {
        Theme.m3 = root.mobile-layout;
    }
    changed dark-theme => {
        Theme.dark = root.dark-theme;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    HorizontalLayout {
        // ------------------------------------------------------------ боковая панель
        if !root.compact: Rectangle {
            width: 236px;
            background: Theme.surface;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                HorizontalLayout {
                    padding-bottom: 18px;
                    padding-left: 6px;
                    spacing: 10px;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 12px;
                        background: Theme.accent;
                        Icon { x: 7px; y: 7px; size: 24px; glyph: "M12 2.5 V12 M6.4 5.7 A9 9 0 1 0 17.6 5.7"; tint: Theme.on-accent; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Reality"; color: Theme.text; font-size: 18px; font-weight: 800; }
                        Text { text: "VPN-клиент"; color: Theme.dim; font-size: 11px; }
                    }
                }
                RailItem { glyph: "M3 11 L12 3 L21 11 M5.5 9.5 V20 H18.5 V9.5"; label: "Главная"; selected: root.active-tab == 0; activated => { root.active-tab = 0; } }
                RailItem { glyph: "M4 5 H20 V11 H4 Z M4 13 H20 V19 H4 Z M8 8 H8.1 M8 16 H8.1"; label: "Серверы"; selected: root.active-tab == 1; activated => { root.active-tab = 1; } }
                RailItem { glyph: "M3 12 H7 L10 5 L14 19 L17 12 H21"; label: "Соединения"; selected: root.active-tab == 2; activated => { root.active-tab = 2; } }
                RailItem { glyph: "M4 7 H20 M4 17 H20 M9 4 V10 M15 14 V20"; label: "Настройки"; selected: root.active-tab == 3; activated => { root.active-tab = 3; } }
                RailItem { glyph: "M12 3 A9 9 0 1 1 11.99 3 Z M12 11 V17 M12 7.5 V7.6"; label: "О приложении"; selected: root.active-tab == 4; activated => { root.active-tab = 4; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: root.connected ? Theme.accent-soft : Theme.surface-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: root.connected ? Theme.accent : (root.idle ? Theme.faint : Theme.warn); }
                        }
                        Text {
                            text: root.connected ? "Защищено" : (root.idle ? "Не подключено" : "Подождите…");
                            color: root.connected ? Theme.accent : Theme.dim;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        if !root.compact: Rectangle { width: 1px; background: Theme.outline; }

        // ------------------------------------------------------------------ страницы
        VerticalLayout {
            horizontal-stretch: 1;

            // ===================================================== Главная
            if root.active-tab == 0: ScrollView {
                mouse-drag-pan-enabled: root.mobile-layout;
                HorizontalLayout {
                    padding-left: root.page-pad;
                    padding-right: root.page-pad;
                    padding-top: root.top-pad;
                    padding-bottom: 24px;
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 100;
                        max-width: 680px;
                        alignment: start;
                        spacing: 16px;

                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            padding-top: root.compact ? 8px : 24px;
                            padding-bottom: 6px;
                            HorizontalLayout {
                                alignment: center;
                                PowerButton { state: root.power-state; clicked => { root.connect-requested(); } }
                            }
                            Text {
                                text: root.idle ? "Не подключено" : (root.connected ? "Подключено" : root.status-text);
                                color: root.connected ? Theme.accent : Theme.text;
                                font-size: 26px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.idle ? (root.status-text == "Отключено" ? "Нажмите кнопку, чтобы подключиться" : root.status-text) : root.status-text;
                                color: Theme.dim;
                                font-size: 13px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        Card {
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "ТЕКУЩИЙ СЕРВЕР"; color: Theme.dim; font-size: 11px; font-weight: 700; }
                                    Text { text: root.profile-name == "" ? "Сервер не выбран" : root.profile-name; color: Theme.text; font-size: 17px; font-weight: 700; overflow: elide; }
                                    Text { text: root.server-endpoint-text; color: Theme.dim; font-size: 12px; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { text: root.profile-model.length == 0 ? "Добавить" : "Сменить"; kind: root.profile-model.length == 0 ? 0 : 1; clicked => { root.active-tab = 1; } }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Stat { horizontal-stretch: 1; label: "СКОРОСТЬ"; value: root.connection-speed-text; hint: "по счётчикам ядра"; }
                            Stat { horizontal-stretch: 1; label: "ТРАФИК"; value: "↑ " + root.uploaded-total-text; hint: "↓ " + root.downloaded-total-text; }
                        }

                        if root.group-controls-visible: Card {
                            SectionTitle { title: "Группа серверов"; subtitle: "Выберите группу и узел внутри неё."; }
                            FieldLabel { text: "Группа"; }
                            ComboBox { model: root.group-model; current-index <=> root.selected-group-index; selected => { root.group-selected(root.selected-group-index); } }
                            FieldLabel { text: "Узел"; }
                            ComboBox { model: root.member-model; current-index <=> root.selected-member-index; selected => { root.member-selected(root.selected-member-index); } }
                        }

                        Card {
                            pad: 0px;
                            Rectangle {
                                height: 56px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: "Проверка IP-адреса"; color: Theme.text; font-size: 14px; font-weight: 700; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { glyph: root.show-diagnostics ? "M6 15 L12 9 L18 15" : "M6 9 L12 15 L18 9"; size: 20px; }
                                    }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.show-diagnostics = !root.show-diagnostics; } }
                            }
                            if root.show-diagnostics: VerticalLayout {
                                padding: 12px;
                                padding-top: 0px;
                                spacing: 8px;
                                IpRow { title: "IP СЕРВЕРА"; value: root.server-ip-text; hint: root.server-endpoint-text; action: "Определить"; requested => { root.server-ip-check-requested(); } }
                                IpRow { title: "ПО ОБЫЧНОМУ МАРШРУТУ"; value: root.direct-ip-text; hint: "Маршрут ОС. При активном VPN это может быть адрес VPN."; action: "Проверить"; requested => { root.direct-ip-check-requested(); } }
                                IpRow { title: "ЧЕРЕЗ ПРОКСИ ЯДРА"; value: root.public-ip-text; hint: "Правила JSON могут отправить запрос напрямую."; action: "Проверить"; requested => { root.public-ip-check-requested(); } }
                            }
                        }

                        if root.detail-text != "": Notice { text: root.detail-text; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ===================================================== Серверы
            if root.active-tab == 1: ScrollView {
                mouse-drag-pan-enabled: root.mobile-layout;
                HorizontalLayout {
                    padding-left: root.page-pad;
                    padding-right: root.page-pad;
                    padding-top: root.top-pad;
                    padding-bottom: 24px;
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 100;
                        max-width: 680px;
                        alignment: start;
                        spacing: 16px;

                        PageTitle { title: "Серверы"; subtitle: "Импортируйте ссылку VLESS или выберите сохранённый профиль."; }

                        Card {
                            SectionTitle { title: "Сохранённые серверы"; subtitle: root.profile-count; }
                            if root.profile-model.length == 0: Rectangle {
                                height: 64px;
                                border-radius: 14px;
                                background: Theme.surface-2;
                                Text { text: "Пока нет ни одного сервера. Добавьте его ниже."; color: Theme.dim; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            for profile[index] in root.profile-model: ProfileRow {
                                name: profile;
                                selected: index == root.selected-profile-index;
                                picked => { root.selected-profile-index = index; root.profile-selected(index); }
                            }
                            if root.profile-model.length > 0 && !root.delete-confirmation-visible: Btn {
                                text: "Удалить выбранный";
                                kind: 3;
                                enabled: root.selected-profile-index >= 0;
                                clicked => { root.delete-confirmation-visible = true; }
                            }
                            if root.delete-confirmation-visible: VerticalLayout {
                                spacing: 8px;
                                Notice { danger: true; text: "Удалить выбранный профиль? Это действие нельзя отменить."; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { horizontal-stretch: 1; text: "Отмена"; clicked => { root.delete-confirmation-visible = false; } }
                                    Btn { horizontal-stretch: 1; text: "Да, удалить"; kind: 3; clicked => { root.confirm-delete-profile(); root.delete-confirmation-visible = false; } }
                                }
                            }
                        }

                        Card {
                            SectionTitle { title: "Добавить сервер"; subtitle: "Секретная ссылка хранится в защищённом хранилище и не попадает в журнал."; }
                            FieldLabel { text: "Название"; }
                            LineEdit { placeholder-text: "Например, Домашний сервер"; text <=> root.profile-name; }
                            FieldLabel { text: "Ссылка VLESS"; }
                            LineEdit { placeholder-text: "vless://…"; input-type: root.show-vless-link ? text : password; text <=> root.vless-link; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { text: root.show-vless-link ? "Скрыть" : "Показать"; clicked => { root.show-vless-link = !root.show-vless-link; } }
                                if root.clipboard-paste-supported: Btn { text: "Вставить"; clicked => { root.paste-profile-link(); } }
                                Rectangle { horizontal-stretch: 1; }
                                Btn { text: "Сохранить"; kind: 0; clicked => { root.save-profile(); } }
                            }
                        }

                        if root.detail-text != "": Notice { text: root.detail-text; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ===================================================== Соединения
            if root.active-tab == 2: ScrollView {
                mouse-drag-pan-enabled: root.mobile-layout;
                HorizontalLayout {
                    padding-left: root.page-pad;
                    padding-right: root.page-pad;
                    padding-top: root.top-pad;
                    padding-bottom: 24px;
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 100;
                        max-width: 680px;
                        alignment: start;
                        spacing: 16px;

                        PageTitle { title: "Соединения"; subtitle: "Статистика и журнал локального ядра."; }

                        HorizontalLayout {
                            spacing: 12px;
                            Stat { horizontal-stretch: 1; label: "АКТИВНЫЕ"; value: root.active-connection-count-text; hint: "соединений"; }
                            Stat { horizontal-stretch: 1; label: "СКОРОСТЬ"; value: root.connection-speed-text; hint: "вход / выход"; }
                        }

                        Card {
                            SectionTitle { title: "Активные потоки"; subtitle: "Адреса назначения видны только в этом приложении."; }
                            Rectangle {
                                height: 220px;
                                border-radius: 14px;
                                background: Theme.surface-2;
                                ScrollView {
                                    mouse-drag-pan-enabled: root.mobile-layout;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        if root.connection-model.length == 0: Text {
                                            text: root.idle ? "Подключитесь, чтобы увидеть активные соединения." : "Сейчас активных соединений нет.";
                                            color: Theme.dim;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                        for row in root.connection-model: Rectangle {
                                            height: 52px;
                                            border-radius: 10px;
                                            background: Theme.surface;
                                            HorizontalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
                                                Text { text: row; color: Theme.text; font-size: 12px; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Card {
                            HorizontalLayout {
                                spacing: 8px;
                                SectionTitle { horizontal-stretch: 1; title: "Журнал"; subtitle: "Секреты в журнале скрыты."; }
                                VerticalLayout { alignment: center; Btn { text: "Копировать"; kind: 2; height: 36px; clicked => { log-view.select-all(); log-view.copy(); } } }
                            }
                            log-view := TextEdit {
                                height: 180px;
                                text <=> root.log-text;
                                read-only: true;
                                wrap: word-wrap;
                                font-size: 12px;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ===================================================== Настройки
            if root.active-tab == 3: ScrollView {
                mouse-drag-pan-enabled: root.mobile-layout;
                HorizontalLayout {
                    padding-left: root.page-pad;
                    padding-right: root.page-pad;
                    padding-top: root.top-pad;
                    padding-bottom: 24px;
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 100;
                        max-width: 680px;
                        alignment: start;
                        spacing: 16px;

                        PageTitle { title: "Настройки"; subtitle: "Оформление, режим подключения и расширенная конфигурация."; }

                        Card {
                            SectionTitle { title: "Оформление"; }
                            Segmented {
                                options: ["Тёмная тема", "Светлая тема"];
                                current <=> root.theme-index;
                                selected(index) => { root.theme-selected(index); }
                            }
                        }

                        Card {
                            SectionTitle { title: "Режим подключения"; }
                            ToggleRow {
                                title: "Полный конфиг ядра";
                                subtitle: "Открывает все возможности ядра: TUN, DNS fake-IP и правила маршрутизации. Совместимость зависит от ОС.";
                                checked <=> root.use-full-config;
                            }
                            if root.system-proxy-supported: ToggleRow {
                                title: "Системный прокси Windows";
                                subtitle: "Временно включает прокси ядра в настройках системы и возвращает прежние значения при отключении.";
                                checked <=> root.enable-system-proxy;
                                enabled: !root.use-full-config;
                            }
                        }

                        if root.use-full-config: Card {
                            SectionTitle { title: "TUN и DNS"; subtitle: "Переключатели записываются в JSON-конфиг. На Windows для TUN нужен wintun.dll рядом с приложением и запуск от имени администратора."; }
                            ToggleRow {
                                title: "TUN";
                                subtitle: "Направлять весь системный трафик через VPN.";
                                checked <=> root.config-tun-enabled;
                                enabled: root.tun-settings-supported;
                            }
                            ToggleRow { title: "Fake-IP DNS"; checked <=> root.fakeip-enabled; }
                            if root.fakeip-enabled: Notice { text: "В Xray FakeDNS может оставить поддельные адреса в системном DNS-кэше после отключения. Если сайты перестанут открываться, очистите DNS-кэш системы."; }

                            if root.android-app-filter-supported: VerticalLayout {
                                spacing: 8px;
                                SectionTitle { title: "Приложения Android"; subtitle: "Пустое поле — VPN для всех приложений. Иначе только для перечисленных package ID."; }
                                ComboBox { model: root.android-app-model; current-index <=> root.selected-android-app-index; }
                                Btn { text: "Добавить в список"; clicked => { root.android-app-add-requested(root.selected-android-app-index); } }
                                LineEdit { placeholder-text: "com.example.app, com.example.other"; text <=> root.android-apps-input; }
                                Btn { text: "Сохранить список"; clicked => { root.android-app-filter-save-requested(); } }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Btn { horizontal-stretch: 1; text: "Применить"; kind: 0; clicked => { root.network-options-save-requested(); } }
                                Btn { horizontal-stretch: 1; text: "Считать из JSON"; clicked => { root.config-options-sync-requested(); } }
                            }
                        }

                        if root.use-full-config: Card {
                            SectionTitle { title: "Правила маршрутизации"; subtitle: "Домен или ссылка сайта (например, https://vk.com/video) — правило действует на весь домен. IP-диапазоны задавайте в CIDR."; }
                            LineEdit { placeholder-text: "Домен или URL: vk.com/video"; text <=> root.route-domain-input; }
                            LineEdit { placeholder-text: "IP/CIDR: 203.0.113.0/24"; text <=> root.route-ip-input; }
                            FieldLabel { text: "Куда направлять"; }
                            ComboBox { model: root.outbound-model; current-index <=> root.selected-outbound-index; selected => { root.outbound-selected(root.selected-outbound-index); } }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { horizontal-stretch: 1; text: "Добавить правило"; kind: 0; clicked => { root.routing-rule-add-requested(); } }
                                Btn { horizontal-stretch: 1; text: "Очистить"; kind: 3; clicked => { root.routing-rules-clear-requested(); } }
                            }
                            Text { text: root.route-rules-summary; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
                        }

                        Card {
                            SectionTitle { title: "JSON-конфигурация ядра"; subtitle: "Для опытных пользователей: полный конфиг sing-box или Xray."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { horizontal-stretch: 1; text: root.config-editor-visible ? "Закрыть редактор" : "Открыть редактор"; clicked => { root.config-editor-visible = !root.config-editor-visible; } }
                                if root.config-editor-visible: Btn { horizontal-stretch: 1; text: "Проверить"; kind: 0; clicked => { root.config-check-requested(); } }
                            }
                            if root.config-editor-visible: VerticalLayout {
                                spacing: 8px;
                                Notice { text: "Секреты в файле хранятся открытым текстом. Ограничьте доступ и используйте link_file. " + root.config-platform-guidance; }
                                LineEdit { placeholder-text: "Путь к JSON-конфигурации"; text <=> root.config-editor-path; }
                                TextEdit {
                                    height: 340px;
                                    text <=> root.config-editor-text;
                                    placeholder-text: "Вставьте конфигурацию ядра…";
                                    wrap: no-wrap;
                                    font-size: 12px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.file-dialog-supported: Btn { horizontal-stretch: 1; text: "Открыть…"; clicked => { root.config-open-requested(); } }
                                    Btn { horizontal-stretch: 1; text: "Загрузить"; clicked => { root.config-load-requested(); } }
                                    Btn { horizontal-stretch: 1; text: "Сохранить"; clicked => { root.config-save-requested(); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.file-dialog-supported: Btn { horizontal-stretch: 1; text: "Сохранить как…"; clicked => { root.config-save-as-requested(); } }
                                    if root.config-reload-supported: Btn { horizontal-stretch: 1; text: "Применить"; kind: 0; clicked => { root.config-reload-requested(); } }
                                }
                            }
                        }

                        if root.recovery-visible: Card {
                            fill: Theme.warn-soft;
                            SectionTitle { title: "Незавершённая сессия системного прокси"; subtitle: "Прошлый запуск закрылся, не вернув настройки прокси."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { horizontal-stretch: 1; text: root.recovery-confirmation-visible ? "Отмена" : "Восстановить…"; clicked => { root.recovery-confirmation-visible = !root.recovery-confirmation-visible; root.discard-recovery-confirmation-visible = false; } }
                                Btn { horizontal-stretch: 1; text: root.discard-recovery-confirmation-visible ? "Отмена" : "Удалить копию…"; kind: 3; clicked => { root.discard-recovery-confirmation-visible = !root.discard-recovery-confirmation-visible; root.recovery-confirmation-visible = false; } }
                            }
                            if root.recovery-confirmation-visible: HorizontalLayout {
                                spacing: 8px;
                                Text { horizontal-stretch: 1; text: "Вернуть прежние настройки прокси?"; color: Theme.warn; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                Btn { text: "Восстановить"; kind: 0; clicked => { root.recover-proxy-requested(); root.recovery-confirmation-visible = false; } }
                            }
                            if root.discard-recovery-confirmation-visible: HorizontalLayout {
                                spacing: 8px;
                                Text { horizontal-stretch: 1; text: "Удалить только сохранённую копию?"; color: Theme.warn; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                Btn { text: "Удалить копию"; kind: 3; clicked => { root.discard-proxy-recovery-requested(); root.discard-recovery-confirmation-visible = false; } }
                            }
                        }

                        if root.tun-cleanup-supported: Card {
                            SectionTitle { title: "Восстановление TUN"; subtitle: "После аварийного завершения запустите очистку, предварительно отключив клиент. Ядро снимает только собственные остатки; нужны права администратора."; }
                            Btn { text: root.tun-cleanup-confirmation-visible ? "Отмена" : "Подготовить очистку…"; enabled: root.idle; clicked => { root.tun-cleanup-confirmation-visible = !root.tun-cleanup-confirmation-visible; } }
                            if root.tun-cleanup-confirmation-visible: HorizontalLayout {
                                spacing: 8px;
                                Text { horizontal-stretch: 1; text: "Выполнить очистку маршрутов Reality Core?"; color: Theme.warn; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                Btn { text: "Очистить"; kind: 3; clicked => { root.tun-cleanup-requested(); root.tun-cleanup-confirmation-visible = false; } }
                            }
                        }

                        if root.detail-text != "": Notice { text: root.detail-text; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ===================================================== О приложении
            if root.active-tab == 4: ScrollView {
                mouse-drag-pan-enabled: root.mobile-layout;
                HorizontalLayout {
                    padding-left: root.page-pad;
                    padding-right: root.page-pad;
                    padding-top: root.top-pad;
                    padding-bottom: 24px;
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 100;
                        max-width: 680px;
                        alignment: start;
                        spacing: 16px;

                        PageTitle { title: "О приложении"; }

                        Card {
                            pad: 22px;
                            HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: 20px;
                                    background: Theme.accent;
                                    Icon { x: 14px; y: 14px; size: 36px; glyph: "M12 2.5 V12 M6.4 5.7 A9 9 0 1 0 17.6 5.7"; tint: Theme.on-accent; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: "Reality Client"; color: Theme.text; font-size: 22px; font-weight: 800; }
                                    Text { text: "Версия " + root.app-version + " · Rust / Slint"; color: Theme.dim; font-size: 13px; }
                                }
                            }
                            Text {
                                text: "Графический клиент для Reality Core — сетевого ядра VLESS/REALITY на Rust. Набор функций зависит от операционной системы и возможностей закреплённой версии ядра.";
                                color: Theme.dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            Btn { text: "Открыть репозиторий ↗"; kind: 0; clicked => { root.open-repository-requested(); } }
                        }

                        Card {
                            SectionTitle { title: "Сведения"; }
                            HorizontalLayout { Text { text: "Разработчик"; color: Theme.dim; font-size: 13px; horizontal-stretch: 1; } Text { text: "ERGFT"; color: Theme.text; font-size: 13px; font-weight: 600; } }
                            HorizontalLayout { Text { text: "Платформы"; color: Theme.dim; font-size: 13px; horizontal-stretch: 1; } Text { text: "Windows · Linux · Android"; color: Theme.text; font-size: 13px; font-weight: 600; } }
                            HorizontalLayout { Text { text: "Лицензия"; color: Theme.dim; font-size: 13px; horizontal-stretch: 1; } Text { text: "GPL-3.0-or-later"; color: Theme.text; font-size: 13px; font-weight: 600; } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ------------------------------------------------ нижняя навигация (узкие окна)
            if root.compact: Rectangle {
                height: 82px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    TabItem { horizontal-stretch: 1; glyph: "M3 11 L12 3 L21 11 M5.5 9.5 V20 H18.5 V9.5"; label: "Главная"; selected: root.active-tab == 0; activated => { root.active-tab = 0; } }
                    TabItem { horizontal-stretch: 1; glyph: "M4 5 H20 V11 H4 Z M4 13 H20 V19 H4 Z M8 8 H8.1 M8 16 H8.1"; label: "Серверы"; selected: root.active-tab == 1; activated => { root.active-tab = 1; } }
                    TabItem { horizontal-stretch: 1; glyph: "M3 12 H7 L10 5 L14 19 L17 12 H21"; label: "Связи"; selected: root.active-tab == 2; activated => { root.active-tab = 2; } }
                    TabItem { horizontal-stretch: 1; glyph: "M4 7 H20 M4 17 H20 M9 4 V10 M15 14 V20"; label: "Настройки"; selected: root.active-tab == 3; activated => { root.active-tab = 3; } }
                    TabItem { horizontal-stretch: 1; glyph: "M12 3 A9 9 0 1 1 11.99 3 Z M12 11 V17 M12 7.5 V7.6"; label: "О нас"; selected: root.active-tab == 4; activated => { root.active-tab = 4; } }
                }
            }
        }
    }
}
